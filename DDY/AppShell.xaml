<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DDY.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DDY.Views">

    <FlyoutItem Title="Cartas">
        <ShellContent
            Title="Cartas"
            ContentTemplate="{DataTemplate views:ListaCartas}"
            Route="ListaCartas" />
    </FlyoutItem>

    <FlyoutItem Title="Favoritos">
        <ShellContent
            Title="Favoritos"
            ContentTemplate="{DataTemplate views:FavoritosPage}"
            Route="FavoritosPage" />
    </FlyoutItem>

</Shell>