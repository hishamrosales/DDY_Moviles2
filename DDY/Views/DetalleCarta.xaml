<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DDY.ViewModels"
             x:Class="DDY.Views.DetalleCarta"
             x:DataType="vm:DetalleViewModel"
             Title="Detalle de Carta">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- imagen -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                    HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Image Source="{Binding Carta.Imagen}"
                           HeightRequest="200"
                           WidthRequest="200"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding Carta.Nombre}"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- atributos -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="10">

                    <!-- categoría -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Categoría" FontAttributes="Bold" TextColor="Gray" />
                        <Label Grid.Column="1" Text="{Binding Carta.Categoria}" FontAttributes="Bold" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <!-- tipo -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Tipo" FontAttributes="Bold" TextColor="Gray" />
                        <Label Grid.Column="1" Text="{Binding Carta.Tipo}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <!-- rareza -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Rareza" FontAttributes="Bold" TextColor="Gray" />
                        <Label Grid.Column="1" Text="{Binding Carta.Rareza}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <!-- estado -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Estado" FontAttributes="Bold" TextColor="Gray" />
                        <Label Grid.Column="1" Text="{Binding Carta.Estado}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <!-- valor -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Valor Estimado" FontAttributes="Bold" TextColor="Gray" />
                        <Label Grid.Column="1"
                               Text="{Binding Carta.ValorEstimado, StringFormat='${0:N2} MXN'}"
                               FontAttributes="Bold"
                               TextColor="#2E7D32" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- boton de favoritos -->
            <Button Text="Marcar / Desmarcar Favorito"
                    Command="{Binding ToggleFavoritoCommand}"
                    BackgroundColor="#FFB300"
                    TextColor="Black"
                    CornerRadius="10"
                    HeightRequest="48"
                    FontAttributes="Bold" />

            <!-- boton editar -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,5,0,10">
                <Button Grid.Column="0"
                        Text="Editar"
                        Command="{Binding IrAEditarCommand}"
                        BackgroundColor="#7E57C2"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="48"
                        FontAttributes="Bold" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>