<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DDY.ViewModels"
             x:Class="DDY.Views.DetalleCarta"
             x:DataType="vm:DetalleViewModel"
             Title="DetalleCarta">
    
    <VerticalStackLayout Padding="20"
                     Spacing="15">

        <Image Source="{Binding Cartas.Imagen}"
           HeightRequest="200"
           Aspect="AspectFit" />

        <Label Text="{Binding Cartas.Nombre}"
           FontSize="22"
           FontAttributes="Bold" />
        <Label Text="{Binding Cartas.Categoria}"
           FontSize="14"
           TextColor="Gray" />
        <Label Text="{Binding Cartas.Tipo}"
           FontSize="14"
           TextColor="Gray" />
        <Label Text="{Binding Cartas.Rareza}"
           FontSize="14"
           TextColor="Gray" />
        <Label Text="{Binding Cartas.Estado}"
           FontSize="14"
           TextColor="Gray" />
        <Label Text="{Binding Cartas.ValorEstimado, StringFormat='${0:N2}'}"
           FontSize="20"
           FontAttributes="Bold"
           TextColor="DarkGreen" />
    </VerticalStackLayout>

</ContentPage>