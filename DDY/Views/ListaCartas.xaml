<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DDY.Views.ListaCartas"
             Title="ListaCartas">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="🎴 Catálogo de Cartas Pokémon"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding}">
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        StrokeThickness="1"
                        Padding="10"
                        Margin="0,5">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding Nombre}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Categoria}" />

                            <Label
                                Text="{Binding Tipo}" />

                            <Label
                                Text="{Binding Rareza}" />

                            <Label
                                Text="{Binding Estado}" />

                            <Label
                                Text="{Binding ValorEstimado, StringFormat='Valor estimado: ${0:F2}'}" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>